{
  "buildCommand": "node scripts/canon.mjs build",
  "outputDirectory": "dist",
  "installCommand": "node --version",
  "headers": [
    {"source": "/", "headers": [{"key": "Cache-Control", "value": "no-cache, must-revalidate"}]},
    {"source": "/index.html", "headers": [{"key": "Cache-Control", "value": "no-cache, must-revalidate"}]},
    {"source": "/release.json", "headers": [{"key": "Cache-Control", "value": "no-store"}]},
    {"source": "/asset-manifest.json", "headers": [{"key": "Cache-Control", "value": "no-store"}]}
  ]
}
